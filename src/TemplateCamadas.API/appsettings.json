{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "HealthChecks-UI": {
    "HealthChecks": [
      {
        "Name": "Infrastructure",
        "Uri": "/healthchecks"
      }
    ],
    "Webhooks": [],
    "EvaluationTimeInSeconds": 500,
    "MinimumSecondsBetweenFailureNotifications": 60
  }
}
