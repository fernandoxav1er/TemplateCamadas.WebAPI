{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "JwtSettings": {
    "AutenticacaoJwksUrl": "https://localhost:XXXX/jwks",
    "JwtSecondsToExpire": 3600,
    "RefreshTokenExpiration": 168,
    "ValidIssuers": [
      "https://localhost:XXXX"
    ]
  },

  "HealthChecks-UI": {
    "HealthChecks": [
      {
        "Name": "Infrastructure",
        "Uri": "/healthchecks"
      }
    ],
    "Webhooks": [],
    "EvaluationTimeInSeconds": 500,
    "MinimumSecondsBetweenFailureNotifications": 60
  }
}
